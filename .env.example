# Optional mail server for password-reset links. Leave blank until configured.
NEON_SMTP_HOST=
NEON_SMTP_PORT=587
NEON_SMTP_USER=
NEON_SMTP_PASSWORD=
NEON_SMTP_FROM=

# Optional TURN relay for reliable voice chat on carrier/mobile networks.
# Example: turn:turn.example.com:3478?transport=udp
NEON_TURN_URL=
NEON_TURN_USERNAME=
NEON_TURN_CREDENTIAL=

# Never enable this on production; it exposes reset links in API responses.
NEON_DEV_RESET=0
