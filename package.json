{
  "name": "neon-arena-renderer",
  "version": "5.1.0",
  "private": true,
  "description": "Build tooling for Neon Arena's offline-capable Three.js renderer",
  "scripts": {
    "build:renderer": "esbuild client/renderer3d-next.js --bundle --minify --target=es2020 --format=iife --legal-comments=none --outfile=server/static/renderer3d.js",
    "check:renderer": "node --check client/renderer3d-next.js && node --check server/static/renderer3d.js"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}

