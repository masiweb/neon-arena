# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the documented sample)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# Python runtime files
__pycache__/
*.py[cod]
.pytest_cache/
/server/data/

# Android build output and private signing material
*.apk
*.aab
*.jks
*.keystore
*.p12
*.key
/android/.gradle/
/android/local.properties
/android/app/build/
/android/app/src/main/assets/

# Packaged releases are generated from source
/release/

# ChatGPT Sites preview/scaffold is not part of the Ubuntu game server
/.openai/
/app/
/build/
/components/
/db/
/drizzle/
/examples/
/hooks/
/lib/
/public/
/scripts/
/vendor/
/worker/
/components.json
/drizzle.config.ts
/eslint.config.mjs
/next.config.ts
/package-lock.json
/package.json
/postcss.config.mjs
/tsconfig.json
/vite.config.ts
/.npmrc
/tests/rendered-html.test.mjs
/tests/ui-components.test.mjs
